# ── Provider switch ─────────────────────────────────────────────────────
# cursor_cli    — Cursor subscription via local `agent` CLI (recommended)
# cursor_proxy  — Cursor via local OpenAI-compatible proxy (see README)
# anthropic     — Claude API (set ANTHROPIC_API_KEY + token budget below)
# openai        — standard OpenAI (production)
# groq          — free interim at console.groq.com
LLM_PROVIDER=cursor_cli

# ── Anthropic / Claude (use when LLM_PROVIDER=anthropic) ─────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_STRONG_MODEL=claude-sonnet-4-6
# ANTHROPIC_FAST_MODEL=claude-haiku-4-5
# ANTHROPIC_MAX_TOKENS=8192
# ANTHROPIC_FAST_MAX_TOKENS=2048
# ANTHROPIC_TOKEN_BUDGET=200000

# ── OpenAI (use when LLM_PROVIDER=openai) ─────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key-here
LLM_STRONG_MODEL=gpt-4o
LLM_FAST_MODEL=gpt-4o-mini

# ── Groq interim (use when LLM_PROVIDER=groq) ───────────────────────────
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FAST_MODEL=openai/gpt-oss-20b

# ── Cursor proxy (use when LLM_PROVIDER=cursor_proxy) ───────────────────
# 1. npm install -g cursor-agent-api-proxy
# 2. Set CURSOR_API_KEY below
# 3. In another terminal: cursor-agent-api-proxy start
CURSOR_API_KEY=crsr_your-key-here
CURSOR_PROXY_BASE_URL=http://localhost:4646/v1
CURSOR_PROXY_MODEL=auto

# ── Flutter artifacts (default on) ────────────────────────────────────────
# Writes a runnable Flutter project to apps/{run_id}/flutter from the build
# sketch. Set FLUTTER_ARTIFACTS=0 to skip.
# FLUTTER_ARTIFACTS=1

# ── Flutter emulator (optional, slower) ───────────────────────────────────
# Set FLUTTER_EMULATOR=1 to launch the HTML preview inside a Flutter WebView
# on an Android emulator (requires Flutter SDK + running emulator).
# FLUTTER_EMULATOR=1
