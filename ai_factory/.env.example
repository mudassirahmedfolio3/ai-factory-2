# ── Provider switch ─────────────────────────────────────────────────────
# cursor_cli    — Cursor subscription via local `agent` CLI (recommended)
# cursor_proxy  — Cursor via local OpenAI-compatible proxy (see README)
# openai        — standard OpenAI (production)
# groq          — free interim at console.groq.com
LLM_PROVIDER=cursor_cli

# ── OpenAI (use when LLM_PROVIDER=openai) ─────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key-here
LLM_STRONG_MODEL=gpt-4o
LLM_FAST_MODEL=gpt-4o-mini

# ── Groq interim (use when LLM_PROVIDER=groq) ───────────────────────────
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FAST_MODEL=openai/gpt-oss-20b

# ── Cursor proxy (use when LLM_PROVIDER=cursor_proxy) ───────────────────
# 1. npm install -g cursor-agent-api-proxy
# 2. Set CURSOR_API_KEY below
# 3. In another terminal: cursor-agent-api-proxy start
CURSOR_API_KEY=crsr_your-key-here
CURSOR_PROXY_BASE_URL=http://localhost:4646/v1
CURSOR_PROXY_MODEL=auto
